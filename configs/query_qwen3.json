{
    "collection_name": "prd_qwen3_0.6b_bm25_tfidf",
    "dense_model": "Qwen/Qwen3-Embedding-0.6B",
    "sparse_model_path": "models/sparse_model.pkl",
    "dense_prefix": "Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: ",
    "queries": [
        {
            "name": "pure_dense_search",
            "type": "dense",
            "query_text": "Monopoly game for kids",
            "limit": 5
        },
        {
            "name": "pure_sparse_search",
            "type": "sparse",
            "query_text": "Hasbro Monopoly",
            "limit": 5
        },
        {
            "name": "hybrid_search",
            "type": "hybrid",
            "query_text": "board games for 4 years old",
            "limit": 5
        },
        {
            "name": "filtered_hybrid_search",
            "type": "hybrid",
            "query_text": "toy games",
            "filter": {
                "must": [
                    {
                        "key": "productName",
                        "match": {
                            "value": "Monopoly Junior"
                        }
                    }
                ]
            },
            "limit": 3
        },
        {
            "name": "threshold_dense_search",
            "type": "dense",
            "query_text": "Monopoly game for kids",
            "score_threshold": 0.4,
            "limit": 5
        }
    ]
}